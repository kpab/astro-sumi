---
import type { MarkdownHeading } from "astro";
import { Image } from "astro:assets";

import "../styles/prose.css";

import PostNav from "../components/PostNav.astro";
import TableOfContents from "../components/TableOfContents.astro";
import BaseLayout from "./BaseLayout.astro";
import { BLOG } from "../config";
import { formatDate, isoDate } from "../utils/date";
import { readingTime } from "../utils/reading-time";
import { tagSlug, type Post } from "../utils/posts";

interface Props {
  post: Post;
  headings: MarkdownHeading[];
  previous?: Post;
  next?: Post;
}

const { post, headings, previous, next } = Astro.props;
const {
  title,
  description,
  pubDate,
  updatedDate,
  tags,
  heroImage,
  heroImageAlt,
} = post.data;

const minutes = readingTime(post.body);
---

<BaseLayout title={title} description={description}>
  <article class="post wrap">
    <header class="post__header">
      <p class="post__stamp eyebrow">
        <time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
        {
          updatedDate && (
            <span class="post__updated">
              · Updated{" "}
              <time datetime={isoDate(updatedDate)}>
                {formatDate(updatedDate)}
              </time>
            </span>
          )
        }
      </p>

      <h1 class="post__title">{title}</h1>
      <p class="lede post__lede">{description}</p>

      <p class="post__meta label">
        {
          tags.map((tag) => (
            <a class="post__tag" href={`/tags/${tagSlug(tag)}/`}>
              #{tag}
            </a>
          ))
        }
        {BLOG.showReadingTime && <span>{minutes} min read</span>}
      </p>
    </header>

    {
      heroImage && (
        <figure class="post__hero">
          <Image
            src={heroImage}
            alt={heroImageAlt ?? ""}
            widths={[640, 960, 1280]}
            sizes="(min-width: 60rem) 60rem, 100vw"
            loading="eager"
          />
        </figure>
      )
    }

    <div class="post__grid">
      <aside class="post__aside">
        <TableOfContents headings={headings} />
      </aside>

      <div class="prose post__body">
        <slot />
      </div>
    </div>

    <PostNav previous={previous} next={next} />
  </article>
</BaseLayout>

<style>
  .post__header {
    max-width: var(--width-prose);
    padding-block: var(--space-12) var(--space-8);
  }

  .post__title {
    margin-top: var(--space-4);
    font-size: var(--text-2xl);
  }

  .post__lede {
    margin-top: var(--space-6);
  }

  .post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-8);
    text-transform: none;
  }

  .post__meta span {
    text-transform: uppercase;
  }

  .post__tag {
    text-decoration: none;
  }

  .post__tag:hover {
    color: var(--color-accent);
  }

  .post__hero {
    margin-bottom: var(--space-12);
  }

  .post__grid {
    display: grid;
    grid-template-columns: minmax(0, var(--width-prose)) 13rem;
    gap: clamp(var(--space-8), 6vw, var(--space-16));
    justify-content: center;
    align-items: start;
    padding-top: var(--space-8);
    border-top: var(--rule-width) solid var(--color-rule);
  }

  /* Contents comes first in the DOM so it is announced before the article,
     then moves to the right-hand rail on wide screens. */
  .post__aside {
    grid-area: 1 / 2;
  }

  .post__body {
    grid-area: 1 / 1;
  }

  @media (max-width: 60rem) {
    .post__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8);
    }

    .post__aside,
    .post__body {
      grid-area: auto;
    }
  }
</style>
