---
import "../styles/fonts.css";
import "../styles/global.css";

import BaseHead, { type ArticleMeta } from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE } from "../config";

interface Props {
  /** Page title, without the site name. Omit on the home page. */
  title?: string;
  description?: string;
  /** Absolute path or URL of the social preview image. */
  ogImage?: string;
  /** Present on article pages; drives OG type and structured data. */
  article?: ArticleMeta;
  /** Let the hero run under the header. */
  overlayHeader?: boolean;
}

const {
  title,
  description = SITE.description,
  ogImage,
  article,
  overlayHeader = false,
} = Astro.props;

const pageTitle = title
  ? `${title} — ${SITE.title}`
  : `${SITE.title} — ${SITE.tagline}`;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <BaseHead
      title={pageTitle}
      description={description}
      ogImage={ogImage}
      article={article}
    />
    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header overlay={overlayHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
