---
import FluidInk from "../components/FluidInk.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { INK, SITE } from "../config";
---

<BaseLayout overlayHeader>
  <FluidInk variant="hero" enabled={INK.hero}>
    <div class="hero">
      <p class="hero__eyebrow">An Astro 7 theme</p>
      <h1 class="hero__title">{SITE.title}</h1>
      <p class="hero__lede">{SITE.tagline}</p>
    </div>
  </FluidInk>
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    padding: var(--space-24) var(--gutter);
    text-align: center;
  }

  .hero__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .hero__title {
    font-family: var(--font-mono);
    font-size: var(--text-hero);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: var(--tracking-hero);
    text-transform: uppercase;
  }

  .hero__lede {
    font-size: var(--text-md);
    color: var(--color-fg-muted);
  }
</style>
