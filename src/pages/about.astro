---
import "../styles/prose.css";

import PageHeader from "../components/PageHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { AUTHOR, SITE, SOCIAL } from "../config";

const colophon = [
  { term: "Framework", value: "Astro 7, static output" },
  { term: "Type", value: "Source Serif 4 · JetBrains Mono" },
  { term: "Palette", value: "Sumi ink, washi paper, vermilion" },
  { term: "Licence", value: "MIT" },
];
---

<BaseLayout title="About" description={AUTHOR.bio}>
  <div class="wrap">
    <PageHeader eyebrow="Colophon" title="About" lede={AUTHOR.bio} />

    <div class="about">
      <div class="prose about__body">
        <p>
          {SITE.title} began as an attempt to answer a narrow question: what would
          a blog look like if it were paced like a printed page rather than a feed?
        </p>

        <p>
          The answer turned out to be mostly subtraction. One serif for reading,
          one monospace for labels, one accent colour spent four times a page,
          and a great deal of space left alone. The only thing added back was the
          ink on the front page — a real fluid simulation, because a theme about
          ink should have some.
        </p>

        <h2>Making it yours</h2>

        <p>
          Everything configurable lives in <code>src/config.ts</code>: the site
          metadata, navigation, social links, how many posts appear per page, and
          whether the ink runs at all. Posts are Markdown or MDX files under
          <code>src/content/blog/</code>, validated against a schema so a missing
          date fails the build rather than the page.
        </p>

        <p>
          Colours are declared once in <code>src/styles/tokens.css</code> using
          <code>light-dark()</code>, so changing the palette means editing one
          block rather than hunting through two themes.
        </p>

        <h2>Elsewhere</h2>

        <ul>
          {
            SOCIAL.map((link) => (
              <li>
                <a href={link.href} rel="noopener">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <aside class="about__aside">
        <p class="tategaki about__rail" aria-hidden="true">
          墨と余白 — INK AND SPACE
        </p>

        <dl class="about__colophon">
          {
            colophon.map((row) => (
              <div class="about__row">
                <dt class="label">{row.term}</dt>
                <dd>{row.value}</dd>
              </div>
            ))
          }
        </dl>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, var(--width-prose)) 13rem;
    gap: clamp(var(--space-8), 6vw, var(--space-16));
    justify-content: center;
    align-items: start;
    padding-block: var(--space-12);
  }

  .about__aside {
    display: flex;
    gap: var(--space-6);
  }

  .about__rail {
    height: 12rem;
  }

  .about__colophon {
    flex: 1;
    margin: 0;
  }

  .about__row + .about__row {
    margin-top: var(--space-6);
  }

  .about__row dd {
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: var(--color-fg-muted);
  }

  @media (max-width: 60rem) {
    .about {
      grid-template-columns: minmax(0, 1fr);
    }

    .about__aside {
      padding-top: var(--space-8);
      border-top: var(--rule-width) solid var(--color-rule);
    }

    .about__rail {
      display: none;
    }
  }
</style>
