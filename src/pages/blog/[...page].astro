---
import type { GetStaticPaths, Page } from "astro";

import PageHeader from "../../components/PageHeader.astro";
import Pagination from "../../components/Pagination.astro";
import PostCard from "../../components/PostCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { BLOG } from "../../config";
import { getPublishedPosts, type Post } from "../../utils/posts";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPublishedPosts();
  return paginate(posts, { pageSize: BLOG.postsPerPage });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Post>;
}

const { page } = Astro.props;

const title = page.currentPage > 1 ? `Blog — page ${page.currentPage}` : "Blog";
---

<BaseLayout
  title={title}
  description="Essays on design, typography and building for the web."
>
  <div class="wrap">
    <PageHeader
      eyebrow="Writing"
      title="Blog"
      lede="Notes on design, typography, and the parts of building for the web that reward slowing down."
    />

    <div class="post-list">
      {page.data.map((post) => <PostCard post={post} />)}
    </div>

    <Pagination page={page} label="Blog posts" />
  </div>
</BaseLayout>

<style>
  .post-list {
    margin-top: var(--space-4);
  }

  .post-list :global(.post-card:last-child) {
    border-bottom: none;
  }
</style>
