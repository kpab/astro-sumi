---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";

import PostLayout from "../../layouts/PostLayout.astro";
import { getAdjacentPosts, getPublishedPosts, type Post } from "../../utils/posts";

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, ...getAdjacentPosts(posts, post.id) },
  }));
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
  previous?: Post;
  next?: Post;
}

const { post, previous, next } = Astro.props;
const { Content, headings } = await render(post);
---

<PostLayout post={post} headings={headings} previous={previous} next={next}>
  <Content />
</PostLayout>
