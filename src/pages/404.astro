---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found"
  description="That page does not exist, or has moved."
>
  <section class="notfound wrap">
    <p class="notfound__code" aria-hidden="true">404</p>
    <p class="notfound__mark" aria-hidden="true">無</p>

    <h1 class="notfound__title">Nothing here</h1>
    <p class="lede notfound__lede">
      The page you asked for does not exist, or has moved somewhere quieter.
    </p>

    <p class="notfound__actions label">
      <a href="/">Home</a>
      <span aria-hidden="true">·</span>
      <a href="/blog/">All posts</a>
    </p>
  </section>
</BaseLayout>

<style>
  .notfound {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 60svh;
    padding-block: var(--space-24);
    text-align: center;
  }

  .notfound__code {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--color-accent);
  }

  .notfound__mark {
    margin-top: var(--space-6);
    font-size: clamp(5rem, 18vw, 9rem);
    line-height: 1;
    color: var(--color-fg-faint);
  }

  .notfound__title {
    margin-top: var(--space-8);
    font-size: var(--text-xl);
  }

  .notfound__lede {
    max-width: 32rem;
    margin-top: var(--space-4);
  }

  .notfound__actions {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-12);
  }

  .notfound__actions a {
    text-decoration: none;
  }

  .notfound__actions a:hover {
    color: var(--color-accent);
  }
</style>
