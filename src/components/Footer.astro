---
import { AUTHOR, SITE, SOCIAL } from "../config";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <p class="site-footer__mark">
      {SITE.title}{SITE.titleMark && <span> {SITE.titleMark}</span>} — {
        SITE.tagline
      }
    </p>

    {
      SOCIAL.length > 0 && (
        <ul class="site-footer__social">
          {SOCIAL.map((link) => (
            <li>
              <a href={link.href} rel="me noopener">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <p class="site-footer__legal">
      © {year} <a href={AUTHOR.url}>{AUTHOR.name}</a> · MIT
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--section-y);
    border-top: var(--rule-width) solid var(--color-rule);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4) var(--space-8);
    padding-block: var(--space-8);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-fg-faint);
  }

  .site-footer__social {
    display: flex;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer a {
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--color-accent);
  }

  .site-footer__legal {
    margin-left: auto;
  }

  @media (max-width: 40rem) {
    .site-footer__legal {
      margin-left: 0;
    }
  }
</style>
