---
import type { MarkdownHeading } from "astro";

import { BLOG } from "../config";

interface Props {
  headings: MarkdownHeading[];
}

// h1 is the article title, and anything below h3 is too granular to help.
const items = Astro.props.headings.filter(
  (heading) => heading.depth >= 2 && heading.depth <= 3,
);

const show = BLOG.showTableOfContents && items.length >= BLOG.tocMinHeadings;
---

{
  show && (
    <nav class="toc" aria-labelledby="toc-heading">
      <h2 class="toc__heading label" id="toc-heading">
        Contents
      </h2>
      <ol class="toc__list">
        {items.map((heading) => (
          <li class="toc__item" data-depth={heading.depth}>
            <a href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .toc {
    position: sticky;
    top: var(--space-8);
  }

  .toc__heading {
    padding-bottom: var(--space-3);
    border-bottom: var(--rule-width) solid var(--color-rule);
  }

  .toc__list {
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .toc__item + .toc__item {
    margin-top: var(--space-3);
  }

  .toc__item[data-depth="3"] {
    padding-left: var(--space-4);
  }

  .toc a {
    color: var(--color-fg-muted);
    text-decoration: none;
  }

  .toc a:hover {
    color: var(--color-accent);
  }

  /* Below the two-column breakpoint the list sits above the article. */
  @media (max-width: 60rem) {
    .toc {
      position: static;
      padding-bottom: var(--space-8);
      border-bottom: var(--rule-width) solid var(--color-rule);
    }

    .toc__list {
      columns: 2;
      column-gap: var(--space-8);
    }
  }

  @media (max-width: 34rem) {
    .toc__list {
      columns: 1;
    }
  }
</style>
