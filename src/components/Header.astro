---
import { NAV, SITE } from "../config";

interface Props {
  /** Lay the header over the hero instead of pushing it down. */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const isCurrent = (href: string) =>
  path === href || (href !== "/" && path.startsWith(`${href}/`));
---

<header class="site-header" data-overlay={overlay ? "" : undefined}>
  <a class="brand" href="/">
    <span class="brand__mark">{SITE.title}</span>
    {
      SITE.titleMark && (
        <span class="brand__sub">{SITE.titleMark} — {SITE.tagline}</span>
      )
    }
  </a>

  <nav class="nav" aria-label="Primary">
    <ul class="nav__list">
      {
        NAV.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-6) var(--gutter);
  }

  .site-header[data-overlay] {
    position: absolute;
    inset-inline: 0;
    top: 0;
  }

  .brand {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    text-decoration: none;
  }

  .brand:hover {
    color: inherit;
  }

  .brand__mark {
    font-family: var(--font-mono);
    font-size: 1.1875rem;
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .brand__sub {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-fg-faint);
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: clamp(var(--space-4), 3vw, var(--space-8));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav a {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-fg-muted);
  }

  .nav a:hover,
  .nav a[aria-current="page"] {
    color: var(--color-fg);
  }

  .nav a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.4em;
  }

  @media (max-width: 40rem) {
    .brand__sub {
      display: none;
    }

    .site-header {
      padding-block: var(--space-4);
    }
  }
</style>
