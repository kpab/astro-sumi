---
import { BLOG } from "../config";
import { formatDateStamp, isoDate } from "../utils/date";
import { readingTime } from "../utils/reading-time";
import { tagSlug, type Post } from "../utils/posts";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, tags, draft } = post.data;
const minutes = readingTime(post.body);
---

<article class="post-card">
  <p class="post-card__stamp label">
    <time datetime={isoDate(pubDate)}>{formatDateStamp(pubDate)}</time>
    {draft && <span class="post-card__draft">Draft</span>}
  </p>

  <div class="post-card__body">
    <h3 class="post-card__title">
      <a href={`/blog/${post.id}/`}>{title}</a>
    </h3>

    <p class="post-card__description">{description}</p>

    <p class="post-card__meta label">
      {
        tags.map((tag) => (
          <a class="post-card__tag" href={`/tags/${tagSlug(tag)}/`}>
            #{tag}
          </a>
        ))
      }
      {
        BLOG.showReadingTime && (
          <span class="post-card__time">{minutes} min read</span>
        )
      }
    </p>
  </div>
</article>

<style>
  .post-card {
    position: relative;
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: var(--space-6);
    padding: var(--space-8) 0;
    border-bottom: var(--rule-width) solid var(--color-rule);
    transition: background var(--duration-fast) var(--ease-out);
  }

  .post-card:hover {
    background: var(--color-bg-subtle);
  }

  .post-card__stamp {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: 0.35rem;
  }

  .post-card__draft {
    color: var(--color-accent);
  }

  .post-card__title {
    font-size: var(--text-lg);
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  /* Stretch the title link over the whole row so the entire card is clickable,
     then lift the tag links back above it. */
  .post-card__title a {
    text-decoration: none;
  }

  .post-card__title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .post-card__description {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-fg-muted);
  }

  .post-card__meta {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-4);
    margin-top: var(--space-4);
    text-transform: none;
  }

  .post-card__tag {
    text-decoration: none;
  }

  .post-card__tag:hover {
    color: var(--color-accent);
  }

  .post-card__time {
    margin-left: auto;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
  }

  @media (max-width: 40rem) {
    .post-card {
      grid-template-columns: 1fr;
      gap: var(--space-3);
      padding-block: var(--space-6);
    }

    .post-card__stamp {
      flex-direction: row;
      gap: var(--space-4);
      padding-top: 0;
    }

    .post-card__time {
      margin-left: 0;
    }
  }
</style>
