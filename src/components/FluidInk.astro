---
import { INK } from "../config";

interface Props {
  variant?: "hero" | "divider";
  /** Overrides INK.strength for this instance. */
  strength?: number;
  /** Overrides INK.autoFlow for this instance. */
  auto?: boolean;
  /** Set false to render only the static gradient. */
  enabled?: boolean;
}

const {
  variant = "hero",
  strength = INK.strength,
  auto = INK.autoFlow,
  enabled = true,
} = Astro.props;
---

<div class:list={["ink", `ink--${variant}`]}>
  {/* Painted first, and stays visible whenever the simulation declines to
      start — no WebGL2, or the visitor prefers reduced motion. */}
  <div class="ink__fallback" aria-hidden="true"></div>

  {
    enabled && (
      <fluid-ink
        class="ink__sim"
        data-strength={String(strength)}
        data-auto={auto ? "1" : "0"}
        aria-hidden="true"
      />
    )
  }

  <div class="ink__content">
    <slot />
  </div>
</div>

{enabled && <script>import "../scripts/fluid-ink";</script>}

<style>
  .ink {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--ink-canvas-bg);
  }

  .ink--hero {
    min-height: min(100svh, 46rem);
  }

  .ink--divider {
    height: 15rem;
  }

  .ink__fallback {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(
        58% 46% at 46% 42%,
        color-mix(in oklab, var(--ink-pigment) 34%, transparent),
        transparent 72%
      ),
      radial-gradient(
        34% 30% at 66% 62%,
        color-mix(in oklab, var(--ink-accent) 16%, transparent),
        transparent 70%
      ),
      radial-gradient(
        40% 34% at 28% 66%,
        color-mix(in oklab, var(--ink-pigment) 18%, transparent),
        transparent 72%
      );
  }

  .ink__sim {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: block;
  }

  /* Grows to fill the band so that anything positioned against its edges lands
     on the edge of the ink rather than the edge of the text inside it. */
  .ink__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex: 1;
    flex-direction: column;
    /* Let the cursor reach the simulation; children opt back in. */
    pointer-events: none;
  }

  .ink__content :global(a),
  .ink__content :global(button) {
    pointer-events: auto;
  }
</style>
